---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Disclaimer from "../components/Disclaimer.astro";
import Problema from "../components/Problema.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import Tools from "../components/Tools.astro";
import Modos from "../components/Modos.astro";
import ComoRodar from "../components/ComoRodar.astro";
import Footer from "../components/Footer.astro";

const title = "radar-cfm-mcp: resoluções do CFM sobre IA para agentes";
const description =
  "Servidor MCP open source para consultar e monitorar resoluções do CFM sobre inteligência artificial, telemedicina e prontuário eletrônico, com instalação local ou pelo conector hospedado. Um projeto IA.med.";
---

<Layout title={title} description={description}>
  <main>
    <Hero />
    <Disclaimer />
    <Problema />
    <ComoFunciona />
    <Tools />
    <Modos />
    <ComoRodar />
  </main>
  <Footer />
</Layout>
